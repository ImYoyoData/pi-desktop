{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.vue",
    "src/preload/*.d.ts",
    "src/shared/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "plugins": [{ "name": "@vue/typescript-plugin" }],
    "paths": {
      "@renderer/*": [
        "./src/renderer/src/*"
      ],
      "marked-katex-extension": [
        "./src/renderer/src/marked-katex-extension.d.ts"
      ]
    }
  }
}
