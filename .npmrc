# China mirrors (npmmirror) — Electron binary & electron-builder deps
#
# npm 12 起这些 *_mirror 键会被判为未知配置并告警（本机实测：
# `npm warn Unknown project config "electron_mirror"`）。等价环境变量为
# ELECTRON_MIRROR / ELECTRON_CUSTOM_DIR / ELECTRON_BUILDER_BINARIES_MIRROR，
# 需要时可在 CI env 或 postinstall 前置脚本中设置；当前取值保持不变，
# 以免国内镜像失效。
electron_mirror=https://npmmirror.com/mirrors/electron/
electron_custom_dir={{ version }}
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/

# Optional: speed up npm package installs in CN
registry=https://registry.npmmirror.com
