{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "scripts/*.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/agent-worker/**/*",
    "src/shared/**/*",
    "tests/main/**/*",
    "tests/shared/**/*",
    "tests/agent-worker/**/*",
    "tests/scripts/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "types": ["electron-vite/node"],
    "paths": {
      "@renderer/*": [
        "./src/renderer/src/*"
      ]
    }
  }
}
