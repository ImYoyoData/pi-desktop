# ============================================================================
# Local-only files. Everything a fresh clone can regenerate, or that belongs to
# one machine (logs, editor state, secrets, build caches), goes here.
# Tracked sources/scripts/tests/resources are deliberately NOT ignored — CI
# runs `npm ci` + `npm run typecheck` + `npm test`, so package-lock.json, tests/,
# scripts/, build/, resources/ and .npmrc must stay in the repo.
# ============================================================================

# --- Dependencies & build output (regenerated by install / build / dist) ---
node_modules
dist
out
release
/.electron-builder-cache/
*.tsbuildinfo

# --- Local logs & scratch files ---
*.log
*.tmp
*.temp
*.bak
*.orig
*.rej
*.pid

# Throwaway verification harness / probe scripts kept out of the repo.
/_ui-preview/
/scratch/
/tmp/

# --- OS metadata ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Editors & IDEs (per-machine state, never shared) ---
.idea
.vscode
*.swp
*.swo
*~

# --- Local secrets & machine overrides ---
.env
.env.*
!.env.example
*.local

# --- Test & tool caches ---
coverage
.vite
.cache
.turbo
.eslintcache

# --- Local reference checkouts & agent scratch dirs ---
_pi-web-ref
_qs-vue-ts
_ev-scaffold2
.codegraph
.pi-subagents
.superpowers
/.pi-glla/
/release-timing/

# >>> pi-desktop filter >>>
pnpm-lock.yaml
# <<< pi-desktop filter <<<
/pnpm-lock.yaml
/promo-video
/.cursor
/.claude
/.commandcode
