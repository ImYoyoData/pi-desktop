{
  "name": "pi-desktop",
  "version": "0.0.1",
  "description": "Pi Desktop — Electron + Vue3 Agent Workspace",
  "main": "./out/main/index.js",
  "author": "ImYoyoData",
  "homepage": "https://github.com/ImYoyoData/pi-desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/ImYoyoData/pi-desktop.git"
  },
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "start": "electron-vite preview",
    "icons": "node scripts/generate-icons.mjs",
    "dist": "npm run icons && npm run build && electron-builder",
    "dist:win": "npm run icons && npm run build && electron-builder --win --x64 --arm64",
    "dist:mac": "npm run icons && npm run build && electron-builder --mac --x64 --arm64",
    "dist:dir": "npm run icons && npm run build && electron-builder --dir",
    "postinstall": "node scripts/patch-highlightjs-exports.mjs && electron-builder install-app-deps"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.82.1",
    "@earendil-works/pi-ai": "0.82.1",
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@vicons/ionicons5": "^0.13.0",
    "@xterm/addon-fit": "^0.10.0",
    "dompurify": "^3.4.12",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.7",
    "monaco-editor": "^0.56.0",
    "naive-ui": "^2.44.1",
    "node-pty": "^1.0.0",
    "pinia": "^3.0.3",
    "splitpanes": "^4.1.2",
    "xterm": "^5.3.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.19.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^7.2.6",
    "vitest": "^3.2.4",
    "vue": "^3.5.25",
    "vue-tsc": "^3.1.6"
  }
}
